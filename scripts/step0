#!/usr/bin/env bash
# Step 0 - Download raw reads from NCBI SRA.
# Input: SRR numbers
# Output: work/01_raw/<SRR>_1.fastq.gz, <SRR>_2.fastq.gz
set -euo pipefail
source "$(dirname "$0")/../config.sh"
mkdir -p "$RAW_DIR" "$LOG_DIR"

prefetch --version | head -1 > "${LOG_DIR}/versions_sratoolkit.txt"

tail -n +2 "$ACCESSIONS" | cut -d',' -f3 | tr -d '\r' | while read -r SRR; do
    [ -z "$SRR" ] && continue
    if [ -s "${RAW_DIR}/${SRR}_1.fastq.gz" ]; then continue; fi
    prefetch "$SRR" -O "${RAW_DIR}/sra"
    fasterq-dump "${RAW_DIR}/sra/${SRR}" --split-files --threads "$THREADS" -O "$RAW_DIR"
    pigz -p "$THREADS" "${RAW_DIR}/${SRR}"_*.fastq
done
